[Unit]
Description=OpenPak WFC dls
After=openpak-postgres.service

[Container]
ContainerName=openpak-wfc-dls
Image=ghcr.io/openpak/wfc-dls:latest
Network=openpak.network
EnvironmentFile=%h/openpak/deploy/wfc-full/wfc-dls.env
Volume=%h/openpak/deploy/wfc-split/token.key:/keys/wfc-token.key:ro,U

[Service]
Restart=always

[Install]
WantedBy=default.target
